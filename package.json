    "@nestjs/swagger": "^6.3.0",
    "@prisma/client": "^5.0.0",
    "@sentry/node": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
