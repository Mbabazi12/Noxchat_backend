generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Presence {
  online
  offline
  ghost
}

enum Gender {
  male
  female
  non_binary
  prefer_not_to_say
}

model User {
  id                 String         @id @default(uuid())
  username           String         @unique
  passwordHash       String
  displayName        String
  gender             Gender?
  avatarUrl          String?
  bio                String?
  birthDate          DateTime
  presence           Presence       @default(offline)
  lastSeenAt         DateTime       @default(now())
  ghostModeEnabled   Boolean        @default(false)
  ghostWhitelist     String[]       @default([])
  ghostScheduleStart String?
  ghostScheduleEnd   String?
  noxCoinBalance     Int            @default(100)
  pushToken          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  blocking           Block[]        @relation("Blocker")
  blockedBy          Block[]        @relation("Blocked")
  muting             Mute[]         @relation("Muter")
  mutedBy            Mute[]         @relation("Muted")
}

// Blocking is modeled as rows, not a String[] on User, so a block always
// points at a real user (FK-enforced) and disappears via cascade if either
// side of it is deleted — a plain ID array on User couldn't guarantee either.
model Block {
  id           String   @id @default(uuid())
  userId       String
  targetUserId String
  createdAt    DateTime @default(now())
  user         User     @relation("Blocker", fields: [userId], references: [id], onDelete: Cascade)
  target       User     @relation("Blocked", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
}

model Mute {
  id           String   @id @default(uuid())
  userId       String
  targetUserId String
  createdAt    DateTime @default(now())
  user         User     @relation("Muter", fields: [userId], references: [id], onDelete: Cascade)
  target       User     @relation("Muted", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

